# MerchantAI - backend environment template
#
# Copy this file to `.env` and fill in values:
#     cp .env.example .env          (macOS/Linux)
#     copy .env.example .env        (Windows)
#
# `.env` is git-ignored. NEVER commit real API keys.

# ---------- Application ----------
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated list of allowed browser origins (Vite dev server default).
# In production, set this to your deployed origin if the API is ever hosted
# separately from the frontend. On the single-origin Vercel deployment it is
# unused, because browser requests are same-origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Data (public demo) ----------
# Paths are relative to the project root. These drive the synthetic demo only.
SALES_FILE=data/raw/merchant_sales.csv
CUSTOMERS_FILE=data/raw/merchant_customers_daily.csv

# ---------- Accounts ----------
# MerchantAI has two account systems and picks one automatically:
#
#   * Built-in accounts (default, nothing to set up). Sign-up, sign-in, uploads,
#     analyses and reports are stored on this machine under LOCAL_DATA_DIR.
#   * Supabase, as soon as SUPABASE_URL and SUPABASE_ANON_KEY are set below.
#
# AUTH_MODE forces one: auto | local | supabase
AUTH_MODE=auto

# Where built-in accounts keep their SQLite database, uploaded files and
# reports. Empty means data/local/ in the project (git-ignored).
LOCAL_DATA_DIR=

# Signs built-in access tokens. Empty means one is generated on first run and
# kept in LOCAL_DATA_DIR. Set it explicitly if several server processes must
# accept the same sign-ins. Never commit a real value.
LOCAL_AUTH_SECRET=
LOCAL_TOKEN_TTL_HOURS=168
LOGIN_ATTEMPT_LIMIT=8
LOGIN_ATTEMPT_WINDOW_SECONDS=900

# ---------- Supabase (optional) ----------
#
# Leave these empty to use built-in accounts.
#
# WHERE EACH VALUE BELONGS
#   SUPABASE_URL ................ backend (local .env + Vercel serverless)
#   SUPABASE_ANON_KEY ........... backend (local .env + Vercel serverless)
#   SUPABASE_JWT_SECRET ......... backend ONLY, and only for legacy HS256 projects
#   SUPABASE_SERVICE_ROLE_KEY ... backend ONLY, optional, never in a browser
#
# The service-role key bypasses Row Level Security. It must never be given to
# the frontend, never committed, and is not required by any route in this app.

# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# The "anon"/publishable key. Safe to expose; it is subject to RLS.
SUPABASE_ANON_KEY=

# Only needed if your project signs tokens with HS256 (Settings -> API -> JWT
# Settings -> JWT Secret). Projects using asymmetric keys are verified through
# the published JWKS instead, and can leave this empty.
SUPABASE_JWT_SECRET=

# Optional. Not used by any current route; keep empty unless you add an
# administrative path that genuinely needs to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Expected `aud` claim. Supabase issues "authenticated" for signed-in users.
SUPABASE_JWT_AUDIENCE=authenticated

# Private storage buckets created by supabase/migrations/0003_storage.sql
SUPABASE_DATA_BUCKET=merchant-data
SUPABASE_REPORTS_BUCKET=merchant-reports

# ---------- Demo account ----------
# The seeded public demo. Set DEMO_USER_ID to the id printed by the seed script;
# the backend then refuses every mutating call from that account, so a visitor
# cannot damage the shared demo for the next one.
DEMO_USER_ID=
DEMO_USER_EMAIL=demo@merchantai.app

# The demo account's password. Shown publicly on the login page — it opens a
# synthetic, read-only workspace and nothing else. With built-in accounts the
# demo is created automatically on first use with this password. With Supabase
# it must match VITE_DEMO_PASSWORD in the frontend environment.
DEMO_PASSWORD=merchant-demo-2026

# ---------- Upload and request limits ----------
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_ROWS=200000
MAX_QUESTION_LENGTH=500
SIGNED_URL_TTL_SECONDS=300

# ---------- LLM (optional) ----------
# The assistant works with this left as-is: it composes answers directly from the
# merchant's computed analytics, offline, with no key and no network.
# Set LLM_ENABLED=true and supply a key only to have a model phrase those answers
# instead. Either way, every figure comes from the data, never from the model.
LLM_ENABLED=false
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=
