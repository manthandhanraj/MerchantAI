# MerchantAI - backend environment template
#
# Copy this file to `.env` and fill in values:
#     cp .env.example .env          (macOS/Linux)
#     copy .env.example .env        (Windows)
#
# `.env` is git-ignored. NEVER commit real API keys.

# ---------- Application ----------
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated list of allowed browser origins (Vite dev server default).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Data ----------
# Paths are relative to the project root.
SALES_FILE=data/raw/merchant_sales.csv
CUSTOMERS_FILE=data/raw/merchant_customers_daily.csv

# ---------- LLM (optional) ----------
# The assistant works with this left as-is: it composes answers directly from the
# merchant's computed analytics, offline, with no key and no network.
# Set LLM_ENABLED=true and supply a key only to have a model phrase those answers
# instead. Either way, every figure comes from the data, never from the model.
LLM_ENABLED=false
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=
