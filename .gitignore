# ---------- Project ----------
# Generated CSVs under data/ ARE committed on purpose (small, synthetic,
# required for the demo + deployment). See docs/DATA_SCHEMA.md.
# Only scratch/experiment output is ignored:
data/scratch/
*.ipynb_checkpoints/
.vercel

# ---------- Presentation / deck build artifacts ----------
# Generated by the slide-deck tooling outside this application. Kept on disk,
# never committed: ~28 MB of rendered slides, Chrome profiles and caches.
.codex-build/
.codex-finalizer/
.chart-data-*/
output/

# Built-in accounts: user databases, uploaded business files, generated
# reports and the token-signing secret. Private user data — never commit it.
data/local/
