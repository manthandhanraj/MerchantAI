POSTGRES_DB=ade
POSTGRES_USER=ade
POSTGRES_PASSWORD=ade
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
SERVER_PORT=8080

# Required for POST/PUT/DELETE API requests. Use a long random value outside local demos.
ADE_API_KEY=change-me-before-running
# Comma-separated origins allowed to call the API from a browser.
ADE_ALLOWED_ORIGINS=http://localhost:8080

# Gemini free-tier key — used from Phase 2 (LLM planner)
GEMINI_API_KEY=your_free_tier_key_here
