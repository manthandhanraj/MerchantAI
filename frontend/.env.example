# MerchantAI - frontend environment template
#
# Copy to `frontend/.env.local` for local development:
#     cp frontend/.env.example frontend/.env.local
#
# Vite only exposes variables prefixed with VITE_. Everything here ends up in
# the browser bundle, so ONLY public values belong in this file.
#
#   NEVER put SUPABASE_SERVICE_ROLE_KEY or SUPABASE_JWT_SECRET here.
#   They bypass or verify security and must stay in the backend environment.

# ---------- API ----------
# Empty in development: requests go to relative /api/... paths and the Vite
# proxy forwards them to the backend on port 8000. Also empty in production,
# because the Vercel deployment serves the app and the API from one origin.
VITE_API_BASE_URL=

# ---------- Supabase (optional) ----------
# Leave both empty to use MerchantAI's built-in accounts: sign-up, sign-in and
# all your data are handled by the MerchantAI backend itself. Set both to use
# Supabase instead — and set the matching backend variables too.
#
# WHERE THESE BELONG
#   Local development ... frontend/.env.local
#   Production .......... Vercel project -> Settings -> Environment Variables,
#                         available at BUILD time (Vite inlines them).

# Project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# The "anon"/publishable key. This is designed to be public: every request it
# makes is still subject to Row Level Security.
VITE_SUPABASE_ANON_KEY=

# ---------- Demo account (Supabase only) ----------
# With built-in accounts, leave these alone: the login page asks the backend for
# the demo credentials, so they always match the account it creates.
#
# With Supabase, set them to the account created by:
#     python scripts/seed_demo.py
# They are intentionally public: they open a seeded, synthetic, READ-ONLY
# workspace and nothing else.
VITE_DEMO_EMAIL=demo@merchantai.app
VITE_DEMO_PASSWORD=
